{
  "version": 2,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "fixeo.ma"
        }
      ],
      "destination": "https://www.fixeo.ma/$1",
      "permanent": true
    }
  ],
  "builds": [
    {
      "src": "api/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "blog/**",
      "use": "@vercel/static"
    },
    {
      "src": "*.xml",
      "use": "@vercel/static"
    },
    {
      "src": "*.txt",
      "use": "@vercel/static"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "js/**",
      "use": "@vercel/static"
    },
    {
      "src": "image/**",
      "use": "@vercel/static"
    },
    {
      "src": "uploads/**",
      "use": "@vercel/static"
    },
    {
      "src": "img/**",
      "use": "@vercel/static"
    },
    {
      "src": "data/**",
      "use": "@vercel/static"
    },
    {
      "src": "heroes/**",
      "use": "@vercel/static"
    },
    {
      "src": "rafi/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/lp-fn/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/artisan-profile-fn/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/enterprise-contact-fn/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "^/api/enterprise-contact$",
      "dest": "/api/enterprise-contact-fn/index.js"
    },
    {
      "src": "^/(plombier|electricien|serrurier|climatisation)-([a-z][a-z-]*)\\.html$",
      "headers": {
        "Location": "/$1/$2"
      },
      "status": 301
    },
    {
      "src": "^/(plombier|electricien|serrurier|climatisation)-([a-z][a-z-]*)$",
      "headers": {
        "Location": "/$1/$2"
      },
      "status": 301
    },
    {
      "src": "^/menuisier/(casablanca|rabat|fes|tanger|marrakech|agadir)$",
      "dest": "/menuisier-$1.html"
    },
    {
      "src": "^/menuisier-casablanca\\.html$",
      "headers": {
        "Location": "/menuisier/casablanca"
      },
      "status": 301
    },
    {
      "src": "^/menuisier-rabat\\.html$",
      "headers": {
        "Location": "/menuisier/rabat"
      },
      "status": 301
    },
    {
      "src": "^/menuisier-fes\\.html$",
      "headers": {
        "Location": "/menuisier/fes"
      },
      "status": 301
    },
    {
      "src": "^/menuisier-tanger\\.html$",
      "headers": {
        "Location": "/menuisier/tanger"
      },
      "status": 301
    },
    {
      "src": "^/menuisier-marrakech\\.html$",
      "headers": {
        "Location": "/menuisier/marrakech"
      },
      "status": 301
    },
    {
      "src": "^/menuisier-agadir\\.html$",
      "headers": {
        "Location": "/menuisier/agadir"
      },
      "status": 301
    },
    {
      "src": "^/peinture-casablanca\\.html$",
      "headers": {
        "Location": "/peintre-casablanca"
      },
      "status": 301
    },
    {
      "src": "^/peintre-casablanca$",
      "dest": "/api/lp-fn?slug=peintre-casablanca"
    },
    {
      "src": "^/macon-casablanca$",
      "dest": "/api/lp-fn?slug=macon-casablanca"
    },
    {
      "src": "^/menuisier-casablanca$",
      "headers": {
        "Location": "/menuisier/casablanca"
      },
      "status": 301
    },
    {
      "src": "^/menuisier-rabat$",
      "headers": {
        "Location": "/menuisier/rabat"
      },
      "status": 301
    },
    {
      "src": "^/menuisier-fes$",
      "headers": {
        "Location": "/menuisier/fes"
      },
      "status": 301
    },
    {
      "src": "^/menuisier-tanger$",
      "headers": {
        "Location": "/menuisier/tanger"
      },
      "status": 301
    },
    {
      "src": "^/menuisier-marrakech$",
      "headers": {
        "Location": "/menuisier/marrakech"
      },
      "status": 301
    },
    {
      "src": "^/menuisier-agadir$",
      "headers": {
        "Location": "/menuisier/agadir"
      },
      "status": 301
    },
    {
      "src": "^/peintre-rabat$",
      "dest": "/api/lp-fn?slug=peintre-rabat"
    },
    {
      "src": "^/peintre-fes$",
      "dest": "/api/lp-fn?slug=peintre-fes"
    },
    {
      "src": "^/peintre-tanger$",
      "dest": "/api/lp-fn?slug=peintre-tanger"
    },
    {
      "src": "^/peintre-marrakech$",
      "dest": "/api/lp-fn?slug=peintre-marrakech"
    },
    {
      "src": "^/peintre-agadir$",
      "dest": "/api/lp-fn?slug=peintre-agadir"
    },
    {
      "src": "^/macon-rabat$",
      "dest": "/api/lp-fn?slug=macon-rabat"
    },
    {
      "src": "^/macon-fes$",
      "dest": "/api/lp-fn?slug=macon-fes"
    },
    {
      "src": "^/macon-tanger$",
      "dest": "/api/lp-fn?slug=macon-tanger"
    },
    {
      "src": "^/macon-marrakech$",
      "dest": "/api/lp-fn?slug=macon-marrakech"
    },
    {
      "src": "^/macon-agadir$",
      "dest": "/api/lp-fn?slug=macon-agadir"
    },
    {
      "src": "^/nettoyage-casablanca$",
      "dest": "/api/lp-fn?slug=nettoyage-casablanca"
    },
    {
      "src": "^/nettoyage-rabat$",
      "dest": "/api/lp-fn?slug=nettoyage-rabat"
    },
    {
      "src": "^/nettoyage-fes$",
      "dest": "/api/lp-fn?slug=nettoyage-fes"
    },
    {
      "src": "^/nettoyage-tanger$",
      "dest": "/api/lp-fn?slug=nettoyage-tanger"
    },
    {
      "src": "^/nettoyage-marrakech$",
      "dest": "/api/lp-fn?slug=nettoyage-marrakech"
    },
    {
      "src": "^/nettoyage-agadir$",
      "dest": "/api/lp-fn?slug=nettoyage-agadir"
    },
    {
      "src": "^/artisan/([a-z0-9][a-z0-9-]{3,118}[a-z0-9])$",
      "dest": "/api/artisan-profile-fn?slug=$1"
    },
    {
      "src": "^/artisan/(.+)$",
      "dest": "/api/artisan-profile-fn?slug=$1"
    },
    {
      "src": "^/fuite-eau/([a-z][a-z-]*)$",
      "dest": "/problem-fuite-eau-$1.html"
    },
    {
      "src": "^/wc-bouche/([a-z][a-z-]*)$",
      "dest": "/problem-wc-bouche-$1.html"
    },
    {
      "src": "^/chauffe-eau-en-panne/([a-z][a-z-]*)$",
      "dest": "/problem-chauffe-eau-en-panne-$1.html"
    },
    {
      "src": "^/porte-bloquee/([a-z][a-z-]*)$",
      "dest": "/problem-porte-bloquee-$1.html"
    },
    {
      "src": "^/serrure-cassee/([a-z][a-z-]*)$",
      "dest": "/problem-serrure-cassee-$1.html"
    },
    {
      "src": "^/panne-electrique/([a-z][a-z-]*)$",
      "dest": "/problem-panne-electrique-$1.html"
    },
    {
      "src": "^/disjoncteur-saute/([a-z][a-z-]*)$",
      "dest": "/problem-disjoncteur-saute-$1.html"
    },
    {
      "src": "^/climatisation-en-panne/([a-z][a-z-]*)$",
      "dest": "/problem-climatisation-en-panne-$1.html"
    },
    {
      "src": "^/prix/([a-z][a-z-]*)/([a-z][a-z-]*)$",
      "dest": "/prix-$1-$2.html"
    },
    {
      "src": "^/a-propos$",
      "dest": "/a-propos.html"
    },
    {
      "src": "^/equipe$",
      "dest": "/equipe.html"
    },
    {
      "src": "^/comment-ca-marche$",
      "dest": "/comment-ca-marche.html"
    },
    {
      "src": "^/nos-garanties$",
      "dest": "/nos-garanties.html"
    },
    {
      "src": "^/verification-artisans$",
      "dest": "/verification-artisans.html"
    },
    {
      "src": "^/charte-qualite$",
      "dest": "/charte-qualite.html"
    },
    {
      "src": "^/engagement-fixeo$",
      "dest": "/engagement-fixeo.html"
    },
    {
      "src": "^/plombier/([a-z][a-z-]*)/([a-z][a-z-]*)$",
      "dest": "/quartier-plombier-$1-$2.html"
    },
    {
      "src": "^/electricien/([a-z][a-z-]*)/([a-z][a-z-]*)$",
      "dest": "/quartier-electricite-$1-$2.html"
    },
    {
      "src": "^/serrurier/([a-z][a-z-]*)/([a-z][a-z-]*)$",
      "dest": "/quartier-serrurerie-$1-$2.html"
    },
    {
      "src": "^/plombier/([a-z][a-z-]*)$",
      "dest": "/plombier-$1.html"
    },
    {
      "src": "^/electricien/([a-z][a-z-]*)$",
      "dest": "/electricien-$1.html"
    },
    {
      "src": "^/serrurier/([a-z][a-z-]*)$",
      "dest": "/serrurier-$1.html"
    },
    {
      "src": "^/climatisation/([a-z][a-z-]*)$",
      "dest": "/climatisation-$1.html"
    },
    {
      "src": "^/peinture/([a-z][a-z-]*)$",
      "dest": "/peinture-$1.html"
    },
    {
      "src": "^/villes/([a-z][a-z-]*)$",
      "dest": "/villes-$1.html"
    },
    {
      "src": "^/services/([a-z][a-z-]*)$",
      "dest": "/services.html"
    },
    {
      "src": "^/suivi$",
      "dest": "/suivi.html"
    },
    {
      "src": "^/blog/([a-z][a-z0-9-]*)$",
      "dest": "/blog/$1.html"
    },
    {
      "src": "^/blog/?$",
      "dest": "/blog-index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/artisan/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}