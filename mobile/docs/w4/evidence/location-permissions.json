{
  "locationDependency": "~19.0.8",
  "ios": {
    "NSLocationWhenInUseUsageDescription": "Autorisez FIXEO à trouver votre ville uniquement lorsque vous choisissez « Utiliser ma position »."
  },
  "android": [
    {
      "$": {
        "android:name": "android.permission.ACCESS_COARSE_LOCATION"
      }
    },
    {
      "$": {
        "android:name": "android.permission.ACCESS_FINE_LOCATION"
      }
    },
    {
      "$": {
        "android:name": "android.permission.ACCESS_BACKGROUND_LOCATION",
        "tools:node": "remove"
      }
    },
    {
      "$": {
        "android:name": "android.permission.FOREGROUND_SERVICE_LOCATION",
        "tools:node": "remove"
      }
    }
  ],
  "source": "expo config --type introspect; no prebuild or physical build"
}
