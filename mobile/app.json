{
  "expo": {
    "name": "FIXEO",
    "slug": "fixeo-mobile",
    "scheme": "fixeo",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "ma.fixeo.app",
      "supportsTablet": false,
      "buildNumber": "4"
    },
    "android": {
      "package": "ma.fixeo.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 9,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "backgroundColor": "#F7F7F5",
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/rafi/launcher-pb1/adaptive-foreground.png",
        "backgroundColor": "#F7F7F5"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorisez FIXEO à accéder à vos photos pour montrer le problème à RAFI.",
          "cameraPermission": "Autorisez FIXEO à utiliser l’appareil photo pour montrer le problème à RAFI.",
          "microphonePermission": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Autorisez FIXEO à utiliser le microphone pour parler à RAFI.",
          "recordAudioAndroid": true
        }
      ],
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Autorisez FIXEO à trouver votre ville uniquement lorsque vous choisissez « Utiliser ma position ».",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "fixeo-maroc",
    "extra": {
      "eas": {
        "projectId": "bb76a67f-4304-48a6-ad29-ca7382d28a7a"
      }
    },
    "splash": {
      "backgroundColor": "#F7F7F5",
      "resizeMode": "contain"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F7F7F5"
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F7F7F5"
    },
    "icon": "./assets/rafi/launcher-pb1/icon.png"
  }
}
